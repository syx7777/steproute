# 复制为 .env 后填写（.env 已被 .gitignore 排除，不会入库）。
#
# 凭证有两种放法：
#   最省事：直接写在本文件里（明文落盘，仅本地使用）；
#   更安全：留空，改用 `uv run steproute secrets set [--name xxx]`（系统凭据管理器 DPAPI）

# 可选：外网代理。默认不启用（直连）。
# 只有确实需要访问外网且直连不通时，才启用本机代理（例如监听 7892 的 Clash / V2Ray）：
# STEPROUTE_PROXY_URL=http://127.0.0.1:7892

# 可选：LLM API Key。写这里即可生效（明文落盘，.env 已 gitignore）；
#   留空则回退到 `uv run steproute secrets set`（推荐）或系统环境变量。
STEPROUTE_LLM_API_KEY=
# 可选：覆盖默认网关（vLLM 部署时填本地 OpenAI 兼容地址，如 http://127.0.0.1:8000/v1）
STEPROUTE_LLM_BASE_URL=https://api.deepseek.com/v1

# 可选：默认后端。api = 真实调用网关；sim = 离线确定性仿真（不联网、零成本）
STEPROUTE_BACKEND=api

# 可选：日志与产物目录
STEPROUTE_LOG_LEVEL=INFO
STEPROUTE_ARTIFACTS_DIR=artifacts
STEPROUTE_DATA_DIR=data

# 可选：使用本地加密密钥库时需要的主口令
# STEPROUTE_VAULT_PASSPHRASE=

# 可选：外部来源同步（飞书）。
#   最省事：App ID 与 App Secret 都写这里（.env 已被 .gitignore 排除，不会入库）。
#   更安全：App Secret 留空，改用 `uv run steproute secrets set --name feishu_app_secret`
STEPROUTE_FEISHU_APP_ID=cli_xxx
STEPROUTE_FEISHU_APP_SECRET=
STEPROUTE_FEISHU_BASE_URL=https://open.feishu.cn/open-apis

# 可选：周报写入的知识库（`uv run steproute weekly publish`）
STEPROUTE_FEISHU_WEEKLY_SPACE_ID=0000000000000000000
# 可选：模板标题关键词，用于在知识库内自动匹配周报模板（默认「模板」）
STEPROUTE_FEISHU_WEEKLY_TEMPLATE_KEYWORD=模板